    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "browser:check": "tsx --env-file-if-exists=.env scripts/browser-check.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.3.0",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.9",
    "openai": "^6.0.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.1.0"

# Copy to .env; never commit real credentials. Optional providers may be blank.
DATABASE_URL=postgresql://hyperion:change_me@localhost:5432/hyperion
OPENAI_API_KEY=
SEARCH_API_KEY=
SEARCH_PROVIDER=brave
CONTACT_ENRICHMENT_API_KEY=
EMAIL_VERIFICATION_API_KEY=
APP_URL=http://localhost:3000
AUTH_SECRET=replace_with_random_at_least_32_character_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_random_at_least_12_character_password
CRON_SECRET=replace_with_random_secret
# Set false for a production bootstrap with no demonstration leads.
SEED_DEMO=true
# Used by compose.yaml only; choose a strong independent password.
POSTGRES_PASSWORD=
